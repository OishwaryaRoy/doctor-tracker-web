# Copy to .env.local and adjust. Never commit .env.local.

# Base URL of the Doctor Tracker API (server-side only — used by the /api rewrite and
# the server-side session check; never exposed to the browser).
#   Local:      http://localhost:4000
#   Production: https://<your-api-project>.vercel.app
API_URL=http://localhost:4000

# Must match the API's COOKIE_NAME (default dt_session).
SESSION_COOKIE_NAME=dt_session

# Show the "Use Admin / Use Viewer" demo-account buttons on the login page.
NEXT_PUBLIC_DEMO_MODE=true
